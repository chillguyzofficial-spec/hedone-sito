# Hedoné — URL senza .html, vecchi indirizzi WordPress, compressione e cache
# (host e https li gestisce già Aruba: qui non si forzano)
Options -MultiViews
RewriteEngine On

# 0) pagina Sommelier e relativo accesso di anteprima: tolti, si torna alla home
RewriteRule ^(sommelier|preview-login)(\.html)?/?$ https://%{HTTP_HOST}/ [R=301,L]

# 1) vecchi indirizzi WordPress -> pagine nuove
RewriteRule ^serata-karaoke/?$ https://%{HTTP_HOST}/serate [R=301,L]
RewriteRule ^gallery/?$ https://%{HTTP_HOST}/serate [R=301,L]
RewriteRule ^contattaci/?$ https://%{HTTP_HOST}/#prenota [R=301,NE,L]
RewriteRule ^privacy-policy/?$ https://%{HTTP_HOST}/privacy [R=301,L]

# 2) slash finale sulle pagine: /menu/ -> /menu (i percorsi relativi restano giusti)
RewriteRule ^(chi-siamo|menu|serate|privacy)/$ https://%{HTTP_HOST}/$1 [R=301,L]

# 3) indirizzi con .html -> indirizzo pulito (solo richieste del browser: niente cicli con la riscrittura interna)
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://%{HTTP_HOST}/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([a-z0-9-]+)\.html[\s?] [NC]
RewriteRule ^([a-z0-9-]+)\.html$ https://%{HTTP_HOST}/$1 [R=301,L]

# 4) indirizzo pulito -> file .html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([a-z0-9-]+)$ $1.html [L]

# Compressione di testo, CSS, JS, SVG
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json
</IfModule>

# Cache: foto, video e font 30 giorni; CSS e JS 1 giorno (si aggiornano spesso); HTML sempre controllato
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
